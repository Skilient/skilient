{
  "password_change": {
    "attempts_until_rate_limited": [
      "wrong_password",
      "wrong_password",
      "wrong_password",
      "rate_limited"
    ],
    "effects": {
      "new_password_grant": {
        "error_code": null,
        "status": 200
      },
      "old_password_grant": {
        "error_code": "invalid_credentials",
        "status": 400
      },
      "other_device_after": "/signin",
      "password_changed_events_after": 1,
      "password_changed_events_before": 0,
      "sessions_after": 1,
      "sessions_before": 2,
      "this_device_after": "/settings/security"
    },
    "refusals": {
      "confirm_mismatch": {
        "code": "invalid_input",
        "message": "Check the highlighted fields."
      },
      "same_as_current": {
        "code": "invalid_input",
        "message": "Check the highlighted fields."
      },
      "too_short": {
        "code": "invalid_input",
        "message": "Check the highlighted fields."
      },
      "wrong_current": {
        "code": "wrong_password",
        "message": "That isn't your current password. Signed up with Google? Use \"Forgot password\" on the sign-in page to set one."
      }
    },
    "success": {
      "code": "ok",
      "message": null
    }
  }
}
