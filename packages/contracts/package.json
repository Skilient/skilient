{
  "name": "@skilient/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./gen/index.ts",
    "./*": "./gen/skilient/*.ts"
  },
  "scripts": {
    "gen": "buf generate && node scripts/index.mjs",
    "check": "buf lint && buf format --diff --exit-code && pnpm gen && git diff --exit-code -- gen",
    "breaking": "node scripts/breaking.mjs",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.17.0",
    "typescript": "6.0.3"
  }
}
