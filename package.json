{
  "name": "skilient-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "typecheck": "pnpm -r --workspace-concurrency=4 typecheck",
    "lint": "pnpm -r --workspace-concurrency=4 lint",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:contract": "pnpm -r --workspace-concurrency=1 test:contract",
    "test:e2e": "pnpm --filter web test:e2e",
    "test:e2e:portals": "pnpm --filter web test:e2e:portals",
    "contracts:gen": "pnpm --filter @skilient/contracts gen",
    "contracts:check": "pnpm --filter @skilient/contracts check",
    "services:bundle": "pnpm --filter @skilient/host bundle",
    "services:image": "docker build -f packages/host/Dockerfile -t skilient/services:dev .",
    "services:smoke": "pnpm --filter @skilient/host smoke",
    "db:start": "pnpm --filter web db:start",
    "db:reset": "pnpm --filter web db:reset",
    "db:test": "pnpm --filter web db:test",
    "db:types": "pnpm --filter web db:types"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22 <23"
  }
}
