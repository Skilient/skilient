{
  "$comment": "Every event type in platform.events: who must publish it and who must handle it, and the workstream that owes it. tools/lint/test/events.test.ts fails when a service in services/ does not declare (src/events.ts) an event it owes, or publishes one not listed here. Payloads carry ids, flags, hashes and staff-curated catalogue labels only.",
  "events": {
    "user.created": {
      "producers": [
        "identity"
      ],
      "consumers": [
        "people",
        "content"
      ],
      "payload": "user_id, role, university_id, provider, visibility, onboarding defaults, status, agreement_accepted"
    },
    "user.deleted": {
      "producers": [
        "identity"
      ],
      "consumers": [
        "people",
        "content",
        "messaging",
        "work",
        "ranking",
        "community",
        "credentials",
        "notify",
        "trust",
        "market",
        "billing",
        "media"
      ],
      "payload": "user_id; every service removes the user's rows and publishes user.deletion_confirmed"
    },
    "user.deletion_requested": {
      "producers": [
        "identity"
      ],
      "consumers": [
        "people"
      ],
      "payload": "delete_after"
    },
    "user.deletion_cancelled": {
      "producers": [
        "identity"
      ],
      "consumers": [
        "people"
      ],
      "payload": "(subject only)"
    },
    "user.deletion_confirmed": {
      "producers": [
        "people",
        "content",
        "messaging",
        "work",
        "ranking",
        "community",
        "credentials",
        "notify",
        "trust",
        "market",
        "billing",
        "media"
      ],
      "consumers": [
        "identity"
      ],
      "payload": "user_id; producer role identifies the service"
    },
    "user.tokens_revoked": {
      "producers": [
        "identity"
      ],
      "consumers": [],
      "payload": "tv, reason; read by every service's token verifier (platform revocation cache), not a consumer"
    },
    "session.revoked": {
      "producers": [
        "identity"
      ],
      "consumers": [],
      "payload": "session_id, reason"
    },
    "user.two_factor_changed": {
      "producers": [
        "identity"
      ],
      "consumers": [],
      "payload": "on, reason"
    },
    "user.mfa_reset": {
      "producers": [
        "identity"
      ],
      "consumers": [],
      "payload": "reset_at"
    },
    "user.email_domain_changed": {
      "producers": [
        "identity"
      ],
      "consumers": [
        "people"
      ],
      "payload": "user_id, email_domain"
    },
    "audit.recorded": {
      "producers": [
        "identity",
        "people"
      ],
      "consumers": [
        "trust"
      ],
      "payload": "audit_id, action, target_type, target_id; trust builds the /ops audit view (W10)"
    },
    "university.domains_changed": {
      "producers": [
        "people"
      ],
      "consumers": [
        "identity",
        "notify"
      ],
      "payload": "university_id, live_at, domains [{domain, kind}]; notify sends launch emails when live_at is set (W9)"
    },
    "profile.gate_changed": {
      "producers": [
        "people"
      ],
      "consumers": [
        "identity"
      ],
      "payload": "user_id, has_profile, role, university_id, onboarding_complete, onboarding_step, status"
    },
    "profile.updated": {
      "producers": [
        "people"
      ],
      "consumers": [
        "messaging",
        "ranking",
        "market",
        "trust",
        "content"
      ],
      "payload": "ids, enums and flags of the profile (no names, no city); department_hash (sha256 of the department text, W3)"
    },
    "profile.image_replaced": {
      "producers": [
        "people"
      ],
      "consumers": [
        "media"
      ],
      "payload": "user_id, which image; media deletes the old file (W9)"
    },
    "friendship.changed": {
      "producers": [
        "people"
      ],
      "consumers": [
        "content",
        "messaging"
      ],
      "payload": "user_a, user_b, friends"
    },
    "friend_request.changed": {
      "producers": [
        "people"
      ],
      "consumers": [
        "notify"
      ],
      "payload": "sender, receiver, status"
    },
    "block.changed": {
      "producers": [
        "people"
      ],
      "consumers": [
        "content",
        "messaging"
      ],
      "payload": "blocker, blocked, blocked flag"
    },
    "mute.changed": {
      "producers": [
        "people"
      ],
      "consumers": [
        "content"
      ],
      "payload": "user_id, muted_id, muted flag"
    },
    "onboarding.advanced": {
      "producers": [
        "people"
      ],
      "consumers": [
        "trust"
      ],
      "payload": "user_id, step; trust forwards to analytics (W10)"
    },
    "onboarding.completed": {
      "producers": [
        "people"
      ],
      "consumers": [
        "trust"
      ],
      "payload": "user_id; trust forwards to analytics (W10)"
    },
    "tour.ended": {
      "producers": [
        "people"
      ],
      "consumers": [
        "trust"
      ],
      "payload": "user_id, tour, how; trust forwards to analytics (W10)"
    },
    "config.portals_changed": {
      "producers": [
        "trust"
      ],
      "consumers": [
        "identity"
      ],
      "payload": "recruiter, university, faculty (W10)"
    },
    "org.member_changed": {
      "producers": [
        "market"
      ],
      "consumers": [
        "identity"
      ],
      "payload": "user_id, org_domain or null (W11)"
    },
    "badge.count_changed": {
      "producers": [
        "notify",
        "messaging",
        "work",
        "community",
        "market"
      ],
      "consumers": [
        "people"
      ],
      "payload": "user_id, key, count (absolute); keys allow-listed per producer in services/people/src/store/copies.ts"
    },
    "milestone.reached": {
      "producers": [
        "work",
        "credentials",
        "ranking"
      ],
      "consumers": [
        "people"
      ],
      "payload": "user_id, key"
    },
    "milestone.cleared": {
      "producers": [
        "work",
        "credentials",
        "ranking"
      ],
      "consumers": [
        "people"
      ],
      "payload": "user_id, key"
    },
    "fact.value_changed": {
      "producers": [
        "work",
        "ranking"
      ],
      "consumers": [
        "people"
      ],
      "payload": "user_id, key, value (schema per key in people)"
    },
    "skill.changed": {
      "producers": [
        "work"
      ],
      "consumers": [
        "people",
        "content"
      ],
      "payload": "user_id, skill_id, skill_label (catalogue), level"
    },
    "group.member_changed": {
      "producers": [
        "work",
        "community"
      ],
      "consumers": [
        "people",
        "content"
      ],
      "payload": "kind, group_id, user_id, member, role (member | officer | president; optional, societies) (ids only)"
    },
    "post.created": {
      "producers": [
        "content"
      ],
      "consumers": [
        "notify",
        "trust"
      ],
      "payload": "post_id, author_id, type, audience, university_id, society_id, venture_id (W3); notify tells society followers (W9), trust forwards analytics (W10)"
    },
    "post.removed": {
      "producers": [
        "content"
      ],
      "consumers": [
        "media",
        "trust"
      ],
      "payload": "post_id, author_id, reason (deleted | removed | account_deleted), media_paths; media deletes the files (W9)"
    },
    "comment.created": {
      "producers": [
        "content"
      ],
      "consumers": [
        "notify",
        "trust"
      ],
      "payload": "comment_id, post_id, author_id, post_author_id, parent_author_id, mentioned_ids; notify reads the excerpt back through content (W9)"
    },
    "survey.answered": {
      "producers": [
        "content"
      ],
      "consumers": [
        "trust"
      ],
      "payload": "post_id, user_id, dimension, answer (analytics, W10)"
    },
    "venture.updated": {
      "producers": [
        "work"
      ],
      "consumers": [
        "content"
      ],
      "payload": "venture_id, owner_id, university_id, status, visibility (W5): invite posts"
    },
    "venture.follow_changed": {
      "producers": [
        "work"
      ],
      "consumers": [
        "content"
      ],
      "payload": "venture_id, user_id, following (W5): feed relevance"
    },
    "venture.completed": {
      "producers": [
        "work"
      ],
      "consumers": [
        "content",
        "ranking",
        "credentials",
        "notify"
      ],
      "payload": "venture_id, owner_id, university_id, visibility (W5): content's Shipped post, ranking facts, a Record entry, a notification"
    },
    "society.status_changed": {
      "producers": [
        "community"
      ],
      "consumers": [
        "content"
      ],
      "payload": "society_id, university_id, status (W7): posting as a verified society"
    },
    "university_seat.changed": {
      "producers": [
        "market"
      ],
      "consumers": [
        "content"
      ],
      "payload": "user_id, university_id, role (null when the seat ends) (W11): announcement reach, university hides"
    },
    "university_hide.changed": {
      "producers": [
        "market"
      ],
      "consumers": [
        "content"
      ],
      "payload": "target_type (post | comment), target_id, hidden (W11)"
    },
    "entitlement.changed": {
      "producers": [
        "billing"
      ],
      "consumers": [
        "content"
      ],
      "payload": "subject_id, key, value (null or false when it ends) (W12); every service that gates a paid action copies it"
    },
    "config.changed": {
      "producers": [
        "trust"
      ],
      "consumers": [
        "content"
      ],
      "payload": "key, version, value (W10); content keeps feed.* and survey.*"
    },
    "content.removed": {
      "producers": [
        "trust"
      ],
      "consumers": [
        "content"
      ],
      "payload": "target_type (post | comment), target_id, staff_id (W10)"
    },
    "content.restored": {
      "producers": [
        "trust"
      ],
      "consumers": [
        "content"
      ],
      "payload": "target_type, target_id (W10; an appeal overturned)"
    },
    "post.reports_changed": {
      "producers": [
        "trust"
      ],
      "consumers": [
        "content"
      ],
      "payload": "post_id, reports (open reports, absolute) (W10): the held stage"
    }
  }
}
